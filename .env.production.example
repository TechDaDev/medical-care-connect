# ── Django ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=.example.com,api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_DB=mcc_production
POSTGRES_USER=mcc_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── SSL / HTTPS ─────────────────────────────────────────────────────────
# SECURE_SSL_REDIRECT=true
# DATABASE_SSL_REQUIRE=true
# SECURE_HSTS_SECONDS=31536000

# ── Gunicorn ────────────────────────────────────────────────────────────
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120
# RUN_MIGRATIONS=true

# ── AI-Assisted Intake (DeepSeek) ──────────────────────────────────────
# DEEPSEEK_API_KEY=
# AI_INTAKE_ENABLED=false

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SERVICE_NAME=mcc-backend
LOG_IP_HASH_SALT=change-this-to-a-random-string

# ── Error Monitoring ───────────────────────────────────────────────────
# ERROR_MONITOR_PROVIDER=disabled

# ── Backup ─────────────────────────────────────────────────────────────
# BACKUP_ROOT=/var/backups
# BACKUP_RETENTION_COUNT=7

# ── Application Version ────────────────────────────────────────────────
# APP_VERSION=0.0.0
# APP_RELEASE=
# GIT_COMMIT_SHA=
