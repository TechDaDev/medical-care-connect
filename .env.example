# ── Django ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_DB=mcc_db
POSTGRES_USER=mcc_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Production settings ─────────────────────────────────────────────────
# SECURE_HSTS_SECONDS=31536000
# DATABASE_SSL_REQUIRE=true

# ── Throttle rates (requests per time period) ──────────────────────────
# AUTH_LOGIN_RATE=10/min
# AUTH_REGISTER_RATE=5/hour
# AUTH_REFRESH_RATE=30/min
# AI_INTAKE_RATE=30/hour
# DEFAULT_ANON_RATE=100/hour
# DEFAULT_USER_RATE=1000/hour

# ── AI-Assisted Intake (DeepSeek) ──────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Attachment Storage ─────────────────────────────────────────────────
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_LOCAL_ROOT=
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
ATTACHMENT_SCAN_MODE=disabled
ATTACHMENT_RETENTION_DAYS=0

# Future Railway Bucket (not required yet):
# RAILWAY_BUCKET_ENDPOINT=
# RAILWAY_BUCKET_NAME=
# RAILWAY_BUCKET_ACCESS_KEY=
# RAILWAY_BUCKET_SECRET_KEY=
# RAILWAY_BUCKET_REGION=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_TEMPERATURE=0.2
AI_INTAKE_ENABLED=false
AI_INTAKE_PROVIDER=deepseek
