# ── Django ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_DB=mcc_db
POSTGRES_USER=mcc_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Production settings ─────────────────────────────────────────────────
# SECURE_HSTS_SECONDS=31536000
# DATABASE_SSL_REQUIRE=true

# ── Throttle rates (requests per time period) ──────────────────────────
# AUTH_LOGIN_RATE=10/min
# AUTH_REGISTER_RATE=5/hour
# AUTH_REFRESH_RATE=30/min
# AI_INTAKE_RATE=30/hour
# DEFAULT_ANON_RATE=100/hour
# DEFAULT_USER_RATE=1000/hour

# ── AI-Assisted Intake (DeepSeek) ──────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Attachment Storage ─────────────────────────────────────────────────
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_LOCAL_ROOT=
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
ATTACHMENT_SCAN_MODE=disabled
ATTACHMENT_RETENTION_DAYS=0

# ── Logging ────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_SERVICE_NAME=mcc-backend
# LOG_INCLUDE_REQUESTS=true
# LOG_SLOW_REQUEST_MS=1000
# LOG_IP_HASH_SALT=change-this-in-production

# ── Error Monitoring ───────────────────────────────────────────────────
# ERROR_MONITOR_PROVIDER=disabled
# ERROR_MONITOR_DSN=
# ERROR_MONITOR_ENVIRONMENT=
# ERROR_MONITOR_RELEASE=

# ── Backup ─────────────────────────────────────────────────────────────
# BACKUP_ROOT=
# BACKUP_RETENTION_COUNT=7

# ── Data Export ────────────────────────────────────────────────────────
# DATA_EXPORT_ROOT=
# DATA_EXPORT_EXPIRY_DAYS=7

# ── Application Version ────────────────────────────────────────────────
# APP_VERSION=0.0.0
# APP_RELEASE=
# GIT_COMMIT_SHA=

# Future Railway Bucket (not required yet):
# RAILWAY_BUCKET_ENDPOINT=
# RAILWAY_BUCKET_NAME=
# RAILWAY_BUCKET_ACCESS_KEY=
# RAILWAY_BUCKET_SECRET_KEY=
# RAILWAY_BUCKET_REGION=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_TEMPERATURE=0.2
AI_INTAKE_ENABLED=false
AI_INTAKE_PROVIDER=deepseek
AI_INTAKE_MAX_QUESTIONS=12
AI_INTAKE_MAX_ANSWER_LENGTH=2000
AI_INTAKE_MAX_ASSISTANT_LENGTH=1000
AI_INTAKE_MAX_HISTORY_MESSAGES=20
AI_INTAKE_MAX_PROMPT_TOKENS=6000
AI_INTAKE_MAX_OUTPUT_TOKENS=1200
AI_INTAKE_MAX_SESSION_TOKENS=40000
AI_INTAKE_MAX_RETRIES=2

# ── Malware Scanning ──
# ATTACHMENT_SCAN_MODE=disabled
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_CONNECT_TIMEOUT=5
# CLAMAV_READ_TIMEOUT=60
# CLAMAV_MAX_STREAM_BYTES=33554432

# ── Backup / Retention ──
# BACKUP_DATABASE_RETENTION_DAYS=30
# BACKUP_ATTACHMENT_MANIFEST_RETENTION_DAYS=90
# BACKUP_MINIMUM_COPIES=3
# BACKUP_DELETE_ENABLED=False
# BACKUP_MAX_AGE_HOURS=30
